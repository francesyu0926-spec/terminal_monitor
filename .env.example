# 服务根地址
API_BASE_URL=https://terminal.sfccn.com

# 业务 API 前缀（登录与业务接口共用）
API_PREFIX=/terminal/zxt-web

# 登录（form-urlencoded）；密码一般为前端加密后的值
LOGIN_CODE=
LOGIN_PASSWORD=

# 登录路径（相对 API_PREFIX）
LOGIN_PATH=/login/pwd

# token 复用时长（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# 鉴权头：登录 JWT 会写入以下每个头（行情等接口为 Secret + Token）
AUTH_HEADERS=Secret,Token

# 兼容旧配置：未设置 AUTH_HEADERS 时使用单个头名
TOKEN_HEADER=
TOKEN_PREFIX=

# 可选：直接写死 token 时将跳过登录
API_TOKEN=

# 请求超时（秒）
API_TIMEOUT=30

# HTTPS 证书校验；内网/代理环境若报 CERTIFICATE_VERIFY_FAILED 可设为 false
VERIFY_SSL=true

# 行情 API 根路径（POST {QUOTES_API_BASE}/quote）
QUOTES_API_BASE=https://terminal.sfccn.com/terminal/quotes/api

# 可选：独立健康检查路径（留空则跳过健康检查用例）
HEALTH_PATH=
