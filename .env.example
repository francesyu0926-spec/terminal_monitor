# 服务根地址
API_BASE_URL=https://terminal.sfccn.com

# 业务 API 前缀（登录与业务接口共用）
API_PREFIX=/terminal/zxt-web

# 登录（form-urlencoded）；密码一般为前端加密后的值
LOGIN_CODE=
LOGIN_PASSWORD=

# 登录路径（相对 API_PREFIX）
LOGIN_PATH=/login/pwd

# token 复用时长（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# 鉴权头：登录 JWT 会写入以下每个头（行情等接口为 Secret + Token）
AUTH_HEADERS=Secret,Token

# 兼容旧配置：未设置 AUTH_HEADERS 时使用单个头名
TOKEN_HEADER=
TOKEN_PREFIX=

# 可选：直接写死 token 时将跳过登录
API_TOKEN=

# 请求超时（秒）
API_TIMEOUT=30

# HTTPS 证书校验；内网/代理环境若报 CERTIFICATE_VERIFY_FAILED 可设为 false
VERIFY_SSL=true

# 行情业务 API 根路径（quote/K线/桌面指标等，均已迁移至 desk）
QUOTES_API_BASE=https://terminal.sfccn.com/terminal/desk/quotes/api

# 仅 health 仍使用旧路径：{QUOTES_HEALTH_API_BASE}/health
QUOTES_HEALTH_API_BASE=https://terminal.sfccn.com/terminal/quotes/api

# quotes/api 与 desk 行情 API 用例可执行时段（@pytest.mark.quote；关闭则全天跑）
QUOTES_API_CALL_WINDOW_ENABLED=true
QUOTES_API_CALL_TIMEZONE=Asia/Shanghai
QUOTES_API_CALL_START=09:30
QUOTES_API_CALL_END=23:39

# 自选分组等（非 desk/api 前缀）
QUOTES_USER_STOCK_BASE=https://terminal.sfccn.com/terminal/quotes

# 资讯等 REST 根路径
REST_API_BASE=https://terminal.sfccn.com/terminal/rest

# 桌面行情页（HTML 冒烟）
DESK_QUOTES_PAGE_URL=https://terminal.sfccn.com/terminal/desk/quotes/

# zxt 桌面资讯详情页（HTML 冒烟，需 Secret/Token）
ZXT_DESKTOP_NEWS_DETAIL_URL=https://zxt.sfccn.com/desktop/news/details/1021804
ZXT_DESKTOP_THEME_INDEX_URL=https://zxt.sfccn.com/desktop/theme/index

# 可选：其它服务独立健康检查（留空则跳过 test_health.py）
HEALTH_PATH=

# 定时巡检：企业微信机器人 Webhook（完整 URL）
WEWORK_WEBHOOK_URL=

# 企微「仅失败推送」起始时刻见 config/monitor_policy.json（勿写在 .env）

# 定时任务：pytest -m 标记，作用范围 api_tests/testcases（默认 smoke）
PYTEST_SCHEDULE_MARKERS=smoke
